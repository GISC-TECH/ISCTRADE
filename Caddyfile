# Reverse proxy com HTTPS automático (Let's Encrypt) quando DOMAIN for um domínio público.
{
	email {$ACME_EMAIL}
}

{$DOMAIN:localhost} {
	encode gzip zstd

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Métricas são apenas para a rede interna (Prometheus): nunca expostas publicamente.
	@internal path /metrics /metrics/*
	handle @internal {
		respond 404
	}

	# WebSocket do painel em tempo real: conexão longa, sem buffer; ao recarregar o Caddy as conexões
	# existentes têm até 5 min para encerrar (o cliente reconecta sozinho com backoff).
	@ws path /api/v1/ws
	handle @ws {
		reverse_proxy backend:8000 {
			flush_interval -1
			stream_close_delay 5m
		}
	}

	@api path /api/* /health /health/* /docs /redoc /openapi.json
	handle @api {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:3000
	}
}
