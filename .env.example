# =============================================================================
# Copie para .env e substitua TODOS os valores CHANGE_ME.
# NUNCA faça commit do arquivo .env.
# =============================================================================

# --- Geral ---
ENVIRONMENT=development
DEBUG=false
PROJECT_NAME="Binance Trading Platform"
DOMAIN=localhost
ACME_EMAIL=admin@example.com

# --- PostgreSQL ---
POSTGRES_USER=trading
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=trading
DATABASE_URL=postgresql+asyncpg://trading:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/trading
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_ECHO=false
# Workers Celery usam NullPool (definido no docker-compose); deixe false para a API.
DB_USE_NULLPOOL=false

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- JWT ---
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=CHANGE_ME_JWT_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# true em produção (HTTPS). O docker-compose.prod.yml já força true.
COOKIE_SECURE=false
COOKIE_DOMAIN=
# Desative após criar os usuários necessários (o primeiro cadastro vira super-admin).
ALLOW_REGISTRATION=true
LOGIN_RATE_LIMIT_PER_MINUTE=10
REGISTER_RATE_LIMIT_PER_MINUTE=5

# --- Criptografia das chaves da Binance (AES-256-GCM) ---
# Base64 de 32 bytes aleatórios. Gere com:
# python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
MASTER_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTES_KEY

# --- Binance USDT-M Futures ---
BINANCE_API_URL=https://fapi.binance.com
BINANCE_TESTNET_API_URL=https://testnet.binancefuture.com
BINANCE_WS_URL=wss://fstream.binance.com
BINANCE_TESTNET_WS_URL=wss://stream.binancefuture.com
BINANCE_USE_TESTNET=true
BINANCE_RECV_WINDOW=5000

# --- Execução ---
# Ordens REAIS só são enviadas se LIVE_TRADING_ENABLED=true E a conta estiver em execution_mode=live.
# Padrão: paper trading (execução simulada).
LIVE_TRADING_ENABLED=false
PAPER_TAKER_FEE=0.0004
PAPER_SLIPPAGE_BPS=2
KILL_SWITCH_CLOSE_POSITIONS=true
BOT_TICK_SECONDS=30
RECONCILE_SECONDS=60
EQUITY_SNAPSHOT_SECONDS=300

# --- CORS (separado por vírgula) ---
CORS_ORIGINS=http://localhost:3000,http://localhost,https://localhost

# --- Celery ---
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
# A API enfileira tarefas (start/stop de contas e bots) no worker. Desligado apenas em testes.
CELERY_DISPATCH_ENABLED=true

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=60

# --- Observabilidade ---
# Logs JSON (uma linha por evento, com request_id/task_id) ou texto.
LOG_FORMAT=json
LOG_LEVEL=INFO
# /metrics (Prometheus) no backend. Não é exposto pelo Caddy; opcionalmente exija um token Bearer.
METRICS_ENABLED=true
METRICS_TOKEN=
# Worker Celery e streams expõem métricas próprias nesta porta (definido no docker-compose).
METRICS_PORT=0
STREAMS_HEARTBEAT_STALE_SECONDS=180
# Perfil opcional "monitoring" (Prometheus + Grafana em 127.0.0.1). Troque a senha antes de subir.
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD
PROMETHEUS_RETENTION=15d

# --- Scanner de mercado (dados públicos da Binance; não precisa de chave) ---
SCANNER_ENABLED=true
# false = dados públicos da mainnet (somente leitura, mais completos); true = testnet
SCANNER_USE_TESTNET=false
SCANNER_INTERVAL=1h
SCANNER_REFRESH_SECONDS=300
SCANNER_MAX_SYMBOLS=40
SCANNER_MIN_QUOTE_VOLUME=50000000
SCANNER_KLINES_CACHE_SECONDS=120
SCANNER_KEEP_SNAPSHOTS=48

# --- Notícias e sentimento (FILTRO de entradas, nunca gatilho de trade) ---
NEWS_ENABLED=true
NEWS_REFRESH_SECONDS=300
NEWS_RETENTION_DAYS=14
# Feeds RSS/Atom separados por vírgula (padrão: CoinDesk, Cointelegraph, Decrypt, The Block)
NEWS_RSS_FEEDS=https://www.coindesk.com/arc/outboundfeeds/rss/,https://cointelegraph.com/rss,https://decrypt.co/feed,https://www.theblock.co/rss.xml
NEWS_SENTIMENT_HALF_LIFE_HOURS=6
NEWS_SENTIMENT_WINDOW_HOURS=48
NEWS_ALERT_MIN_ABS_SENTIMENT=0.5
# CryptoPanic (opcional, plano pago). Vazio = desativado.
CRYPTOPANIC_API_TOKEN=
CRYPTOPANIC_API_URL=https://cryptopanic.com/api/growth/v2/posts/
CRYPTOPANIC_MIN_INTERVAL_SECONDS=900
# X / Twitter API v2 recent search (opcional). Vazio = desativado.
X_BEARER_TOKEN=
X_ACCOUNTS=
X_QUERIES=
X_MAX_RESULTS=20
X_MIN_INTERVAL_SECONDS=900
# LLM compatível com OpenAI (/chat/completions). Sem chave = análise léxica local.
# Só o texto público da notícia é enviado; nunca dados de conta ou chaves.
LLM_API_BASE=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=20
LLM_MAX_CALLS_PER_HOUR=60
LLM_MAX_ITEMS_PER_RUN=20

# --- Calendário econômico ---
ECON_CALENDAR_ENABLED=true
ECON_CALENDAR_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.json
ECON_CALENDAR_REFRESH_SECONDS=3600
ECON_CALENDAR_COUNTRIES=USD
# Eventos manuais (fallback), JSON: [{"title":"FOMC","time":"2026-10-28T18:00:00Z","country":"USD","impact":"high"}]
ECON_CALENDAR_MANUAL_EVENTS=
ECON_ALERT_LEAD_MINUTES=60

# --- Alertas ---
# Alertas são gravados no histórico (tabela alerts) e enviados pelo WhatsApp quando configurado.
ALERTS_ENABLED=true
# Janela anti-spam por tipo de evento/conta (minutos). Pode ser sobrescrita por workspace.
ALERT_THROTTLE_MINUTES=15
# Alerta quando um WebSocket fica desconectado por mais de N segundos.
ALERT_WS_DISCONNECT_SECONDS=120
# Hora (UTC) do resumo diário de PnL.
ALERT_DAILY_SUMMARY_HOUR_UTC=0

# --- WhatsApp (veja docs/ALERTS.md) ---
WHATSAPP_ENABLED=false
# wago (padrão: API hospedada WAGO, wago.hablame.co) | wago_api (wago-api self-hosted)
# | meta_cloud | evolution | generic_http
WHATSAPP_PROVIDER=wago
# wago: vazio = https://wago-api.hablame.co/v1 | wago_api/evolution/generic_http: URL do seu gateway
WHATSAPP_API_URL=
# wago: API key (header "Token") | meta_cloud: access token | evolution: apikey | outros: token do gateway
WHATSAPP_API_TOKEN=
# wago: ID do número/dispositivo WAGO que envia (opcional; vazio = número padrão da conta)
WHATSAPP_DEVICE_ID=
# wago_api: sessão | evolution: instância (WHATSAPP_INSTANCE também é aceito)
WHATSAPP_SESSION=
# meta_cloud: Phone number ID do WhatsApp Business
WHATSAPP_PHONE_NUMBER_ID=
# wago_api/generic_http: cabeçalho de autenticação ("Authorization" + "Bearer " por padrão)
WHATSAPP_AUTH_HEADER=Authorization
WHATSAPP_AUTH_PREFIX="Bearer "
# generic_http: método, cabeçalhos extras (JSON) e corpo JSON com {to}, {to_digits} e {text}
WHATSAPP_HTTP_METHOD=POST
WHATSAPP_EXTRA_HEADERS=
WHATSAPP_BODY_TEMPLATE={"to": "{to}", "text": "{text}"}
# Destinatários padrão (E.164, separados por vírgula). Cada workspace pode definir os seus na tela Monitoramento.
WHATSAPP_TO=+5511999999999
WHATSAPP_TIMEOUT_SECONDS=10

# --- Limites de risco padrão ---
RISK_MAX_RISK_PER_TRADE_PCT=1.0
RISK_MAX_LEVERAGE=5
RISK_MAX_DAILY_LOSS_PCT=3.0
RISK_MAX_DRAWDOWN_PCT=15.0

# --- Frontend (valores usados no build da imagem) ---
# Relativo: o navegador chama a mesma origem e o Caddy encaminha /api/* para o backend.
NEXT_PUBLIC_API_URL=/api/v1
# Destino dos rewrites /api/* do Next.js (dev: http://localhost:8000; Docker: http://backend:8000).
BACKEND_INTERNAL_URL=http://backend:8000
