# =============================================================================
# Copie para .env e substitua TODOS os valores CHANGE_ME.
# NUNCA faça commit do arquivo .env.
# =============================================================================

# --- Geral ---
ENVIRONMENT=development
DEBUG=false
PROJECT_NAME="Binance Trading Platform"
DOMAIN=localhost
ACME_EMAIL=admin@example.com

# --- PostgreSQL ---
POSTGRES_USER=trading
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=trading
DATABASE_URL=postgresql+asyncpg://trading:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/trading
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_ECHO=false
# Workers Celery usam NullPool (definido no docker-compose); deixe false para a API.
DB_USE_NULLPOOL=false

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- JWT ---
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=CHANGE_ME_JWT_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# true em produção (HTTPS). O docker-compose.prod.yml já força true.
COOKIE_SECURE=false
COOKIE_DOMAIN=
# Desative após criar os usuários necessários (o primeiro cadastro vira super-admin).
ALLOW_REGISTRATION=true
LOGIN_RATE_LIMIT_PER_MINUTE=10
REGISTER_RATE_LIMIT_PER_MINUTE=5

# --- Criptografia das chaves da Binance (AES-256-GCM) ---
# Base64 de 32 bytes aleatórios. Gere com:
# python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
MASTER_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTES_KEY

# --- Binance USDT-M Futures ---
BINANCE_API_URL=https://fapi.binance.com
BINANCE_TESTNET_API_URL=https://testnet.binancefuture.com
BINANCE_WS_URL=wss://fstream.binance.com
BINANCE_TESTNET_WS_URL=wss://stream.binancefuture.com
BINANCE_USE_TESTNET=true
BINANCE_RECV_WINDOW=5000

# --- Execução ---
# Ordens REAIS só são enviadas se LIVE_TRADING_ENABLED=true E a conta estiver em execution_mode=live.
# Padrão: paper trading (execução simulada).
LIVE_TRADING_ENABLED=false
PAPER_TAKER_FEE=0.0004
PAPER_SLIPPAGE_BPS=2
KILL_SWITCH_CLOSE_POSITIONS=true
BOT_TICK_SECONDS=30
RECONCILE_SECONDS=60
EQUITY_SNAPSHOT_SECONDS=300

# --- CORS (separado por vírgula) ---
CORS_ORIGINS=http://localhost:3000,http://localhost,https://localhost

# --- Celery ---
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
# A API enfileira tarefas (start/stop de contas e bots) no worker. Desligado apenas em testes.
CELERY_DISPATCH_ENABLED=true

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=60

# --- Limites de risco padrão ---
RISK_MAX_RISK_PER_TRADE_PCT=1.0
RISK_MAX_LEVERAGE=5
RISK_MAX_DAILY_LOSS_PCT=3.0
RISK_MAX_DRAWDOWN_PCT=15.0

# --- Frontend (valores usados no build da imagem) ---
# Relativo: o navegador chama a mesma origem e o Caddy encaminha /api/* para o backend.
NEXT_PUBLIC_API_URL=/api/v1
# Destino dos rewrites /api/* do Next.js (dev: http://localhost:8000; Docker: http://backend:8000).
BACKEND_INTERNAL_URL=http://backend:8000
